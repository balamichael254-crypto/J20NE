SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Web Push (the care screen's real cross-device nudges).
# Generate a pair with:  npx web-push generate-vapid-keys
# The public key ALSO has to be pasted into miss-you-app/push.js
# (VAPID_PUBLIC_KEY) - it identifies the sender and is not a secret.
# The private key is a secret and belongs only here / in Vercel env vars.
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:you@example.com

# Watchlist screen - real posters, trailers, and the whole TMDB catalogue
# instead of a hand-written list. Free, instant signup, no credit card:
#   1. themoviedb.org -> create an account -> Settings -> API
#   2. request a Developer API key (approved instantly for personal use)
#   3. paste either the "API Key (v3 auth)" or the "API Read Access Token
#      (v4 auth)" below - api/movies.js accepts either
# Without this set, the watchlist screen falls back to a small built-in
# list with no posters or trailers, so the app still works either way.
TMDB_API_KEY=YOUR_TMDB_API_KEY
